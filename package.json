{
  "name": "@koohoo/gallery-kit",
  "version": "0.1.1",
  "description": "교안 갤러리 공통 틀: 앱 셸, 표본 계약, AI 지시 세트·Skill, 검사·캡처 도구 (유니티 개발자 양성과정)",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./vite": {
      "types": "./vite.d.mts",
      "default": "./vite.mjs"
    },
    "./package.json": "./package.json"
  },
  "types": "./src/index.ts",
  "bin": {
    "gallery": "./tools/gallery.mjs"
  },
  "files": [
    "src",
    "tools",
    "templates",
    "docs",
    "vite.mjs",
    "vite.d.mts"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "example:build": "npm --prefix example run build",
    "example:check": "npm --prefix example run check"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "highlight.js": "11.12.0",
    "vite-plugin-singlefile": "2.3.3"
  },
  "peerDependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@types/node": "24.0.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "engines": {
    "node": ">=24"
  }
}
